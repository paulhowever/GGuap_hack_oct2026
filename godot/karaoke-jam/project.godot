; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KaraokeJam"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Conductor="*res://addons/conductor/condcutor.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="KaraokeJam"

[editor_plugins]

enabled=PackedStringArray("res://addons/conductor/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[gui]

common/auto_focus_strategy=1

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/multi_bounce_occlusion/enabled=true
