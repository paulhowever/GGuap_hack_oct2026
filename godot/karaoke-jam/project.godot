; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KaraokeJam"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

general/default_playback_type.web=0
driver/enable_input=true

[autoload]

Conductor="*res://addons/conductor/condcutor.gd"
Session="*res://autoload/session.gd"
MenuMusic="*res://autoload/menu_music.gd"
VoiceBridge="*res://autoload/voice_bridge.gd"
Api="*res://autoload/api.gd"
AudioService="*res://autoload/audio_service.gd"
WebShell="*res://autoload/web_shell.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
Performers="*res://autoload/performers.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="KaraokeJam"

[editor_plugins]

enabled=PackedStringArray("res://addons/conductor/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[gui]

common/auto_focus_strategy=1
theme/custom="res://ui/theme/main_theme.tres"

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/multi_bounce_occlusion/enabled=true
environment/defaults/default_clear_color=Color(0.118, 0.102, 0.141, 1)
